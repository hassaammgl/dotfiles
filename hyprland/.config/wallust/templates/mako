font=JetBrainsMono Nerd Font 11
background-color={color0}
text-color={foreground}
border-color={color4}
border-radius=10
border-size=2
default-timeout=4000
width=360
height=110
max-icon-size=48
icons=1
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
sort=-time
padding=12,16
margin=10
group-by=app-name
max-visible=5
layer=overlay
anchor=top-right
markup=1
actions=1
ignore-timeout=0
outer-margin=12

[urgency=low]
border-color={color8}
default-timeout=3000

[urgency=normal]
border-color={color4}
default-timeout=4000

[urgency=critical]
background-color={color0}
text-color={color1}
border-color={color1}
border-size=2
default-timeout=0
