configuration {
  icon-theme: "Papirus";
  display-drun: " ";
  drun-display-format: "{icon} {name}";
  font: "JetBrainsMono Nerd Font 12";
  show-icons: true;
}

* {
  background:     {{background}};
  background-color: {{background}};
  foreground:     {{foreground}};
  text-color:     {{foreground}};
  lightbg:        {{color0}};
  border-color:   {{color8}};
  spacing:        2;
}

window {
  background-color: {{background}};
  border: 1px;
  border-color: {{color8}};
  border-radius: 10;
  padding: 6px;
  width: 40%;
}

inputbar {
  background-color: {{color0}};
  border-radius: 8;
  padding: 6px 12px;
  spacing: 8px;
  children: [ prompt, entry ];
}

prompt {
  text-color: {{color4}};
  font: "JetBrainsMono Nerd Font 14";
}

entry {
  text-color: {{foreground}};
  font: "JetBrainsMono Nerd Font 14";
  placeholder: "Search...";
  placeholder-color: {{color8}};
}

listview {
  background-color: {{background}};
  border-radius: 8;
  spacing: 2px;
  padding: 4px 0;
}

element {
  background-color: transparent;
  text-color: {{foreground}};
  border-radius: 6;
  padding: 8px 12px;
}

element selected {
  background-color: {{color0}};
  text-color: {{color4}};
}

element-icon {
  size: 24px;
}

element-text {
  text-color: inherit;
  vertical-align: 0.5;
  horizontal-align: 0.0;
}

element alternate {
  background-color: transparent;
}

element urgent {
  text-color: {{color1}};
}

scrollbar {
  width: 4px;
  handle-width: 4px;
  handle-color: {{color0}};
}

message {
  background-color: {{color0}};
  border-radius: 8;
  padding: 6px;
}

textbox {
  text-color: {{color8}};
}
