configuration {
  modi: "drun,run,window";
  show-icons: true;
  icon-theme: "Papirus-Dark";
  font: "JetBrainsMono Nerd Font 13";
  display-drun: "󰣇 ";
  display-run: "󰆍 ";
  display-window: "󰖯 ";
  drun-display-format: "{icon}\t{name}";
  window-format: "{w}\t{c}\t{t}";
  hover-select: true;
  me-select-entry: "";
  me-accept-entry: "MousePrimary";
}

* {
  bg:      #141414;
  bg-alt:  #3F3F3F;
  fg:      #FBF9F5;
  fg-dim:  #A8A7A3;
  accent:  #967772;
  urgent:  #484848;
  border:  #A8A7A3;

  background-color: transparent;
  text-color: @fg;
  margin: 0;
  padding: 0;
  spacing: 0;
}

window {
  location: center;
  anchor: center;
  fullscreen: false;
  width: 520px;
  x-offset: 0;
  y-offset: -40px;
  background-color: @bg;
  border: 2px solid;
  border-color: @accent;
  border-radius: 18px;
  padding: 14px;
}

mainbox {
  children: [ inputbar, listview, mode-switcher ];
  spacing: 12px;
  background-color: transparent;
}

inputbar {
  background-color: @bg-alt;
  border-radius: 12px;
  padding: 12px 16px;
  spacing: 12px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @accent;
  font: "JetBrainsMono Nerd Font 16";
  vertical-align: 0.5;
}

entry {
  placeholder: "Search apps, commands…";
  placeholder-color: @fg-dim;
  text-color: @fg;
  font: "JetBrainsMono Nerd Font 14";
  cursor: text;
  vertical-align: 0.5;
}

listview {
  lines: 8;
  columns: 1;
  fixed-height: true;
  dynamic: true;
  scrollbar: false;
  spacing: 4px;
  background-color: transparent;
}

element {
  padding: 10px 14px;
  spacing: 14px;
  border-radius: 12px;
  background-color: transparent;
  text-color: @fg;
  children: [ element-icon, element-text ];
}

element normal.normal,
element alternate.normal {
  background-color: transparent;
  text-color: @fg;
}

element selected.normal,
element selected.active {
  background-color: @accent;
  text-color: @bg;
}

element selected.urgent {
  background-color: @urgent;
  text-color: @bg;
}

element-icon {
  size: 28px;
  cursor: inherit;
  background-color: transparent;
}

element-text {
  vertical-align: 0.5;
  horizontal-align: 0.0;
  text-color: inherit;
  cursor: inherit;
  background-color: transparent;
}

mode-switcher {
  spacing: 8px;
  background-color: transparent;
}

button {
  padding: 8px 0;
  border-radius: 10px;
  background-color: @bg-alt;
  text-color: @fg-dim;
  horizontal-align: 0.5;
}

button selected {
  background-color: @accent;
  text-color: @bg;
}

message {
  background-color: @bg-alt;
  border-radius: 12px;
  padding: 10px 14px;
}

textbox {
  text-color: @fg-dim;
  background-color: transparent;
}
