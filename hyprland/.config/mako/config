font=JetBrainsMono Nerd Font 11
background-color=#191C1A
text-color=#F4F9E7
border-color=#6E8A89
border-radius=10
border-size=2
default-timeout=4000
width=360
height=110
max-icon-size=48
icons=1
icon-path=/usr/share/icons/Papirus-Dark:/usr/share/icons/hicolor
sort=-time
padding=12,16
margin=10
group-by=app-name
max-visible=5
layer=overlay
anchor=top-right
markup=1
